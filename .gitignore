# Ignore dependency libraries; vendor SDK binaries in Release/ are tracked.
**/lib/*.so
**/lib/*.pyd
**/lib/*.dll

scripts/*
!scripts/start_gello_follow.sh
config/*calib*.json
# The 192.168.2.160 site calibration ships so a clone can drive that robot;
# re-run follow-calibrate for any other robot.
!config/cr7_calib.json
config/exit_pose.json
.follow.lock

# Release packaging output
dist/

.venv/
.venv-sdk/
__pycache__/
.pytest_cache/
.ruff_cache/
logs/
_rokae_log_/
